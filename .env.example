# ---- 伺服器 ----
# 監聽埠（Render 會自動注入 PORT；本機預設 3250）
PORT=3250
HOST=0.0.0.0
# 允許連線的前端來源，逗號分隔；* 只適合本機開發
GAME_ALLOWED_ORIGIN=*
# 開局倒數（毫秒）
COUNTDOWN_MS=3000
# 斷線可重連時間（毫秒），逾時當作出局
RECONNECT_MS=10000
# 自動化測試用：縮短一局秒數、調整電腦反應倍率
# MATCH_SECONDS=90
# AI_SPEED_SCALE=1

# ---- 前端 ----
# 前端另外部署（GitHub Pages）時，建置前用 npm run inject 注入；同源部署可留空
GAME_SERVER_URL=http://localhost:3250
